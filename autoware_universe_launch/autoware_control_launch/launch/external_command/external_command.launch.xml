<launch>
  <!-- External command unit: converts the local/remote operator commands into control commands for the gate -->
  <arg name="launch_external_cmd_converter" default="true"/>

  <!-- Process placement -->
  <arg name="target_container" default="/control/control_container"/>
  <arg name="use_intra_process" default="false"/>

  <!-- external cmd converter for local -->
  <group if="$(var launch_external_cmd_converter)">
    <include file="$(find-pkg-share autoware_external_cmd_converter)/launch/external_cmd_converter.launch.py">
      <arg name="node_name" value="external_cmd_converter_local"/>
      <arg name="use_intra_process" value="$(var use_intra_process)"/>
      <arg name="target_container" value="$(var target_container)"/>
      <arg name="in/pedals_cmd" value="/external/local/pedals_cmd"/>
      <arg name="in/steering_cmd" value="/external/local/steering_cmd"/>
      <arg name="in/gear_cmd" value="/external/local/gear_cmd"/>
      <arg name="in/heartbeat" value="/external/local/heartbeat"/>
      <arg name="out/control_cmd" value="/external/local/control_cmd"/>
    </include>
  </group>

  <!-- external cmd converter for remote -->
  <group if="$(var launch_external_cmd_converter)">
    <include file="$(find-pkg-share autoware_external_cmd_converter)/launch/external_cmd_converter.launch.py">
      <arg name="node_name" value="external_cmd_converter_remote"/>
      <arg name="use_intra_process" value="$(var use_intra_process)"/>
      <arg name="target_container" value="$(var target_container)"/>
      <arg name="in/pedals_cmd" value="/external/remote/pedals_cmd"/>
      <arg name="in/steering_cmd" value="/external/remote/steering_cmd"/>
      <arg name="in/gear_cmd" value="/external/remote/gear_cmd"/>
      <arg name="in/heartbeat" value="/external/remote/heartbeat"/>
      <arg name="out/control_cmd" value="/external/remote/control_cmd"/>
    </include>
  </group>
</launch>
